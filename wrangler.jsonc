{
	"$schema": "node_modules/wrangler/config-schema.json",
	"main": ".open-next/worker.js",
	"name": "property-ly",
	"compatibility_date": "2026-11-18",
	"compatibility_flags": [
		"nodejs_compat",
		"global_fetch_strictly_public"
	],
	"assets": {
		"directory": ".open-next/assets",
		"binding": "ASSETS"
	},
	"services": [
		{
			// Self-reference service binding, the service name must match the worker name
			// see https://opennext.js.org/cloudflare/caching
			"binding": "WORKER_SELF_REFERENCE",
			"service": "property-ly"
		}
	],
	"images": {
		// Enable image optimization
		// see https://opennext.js.org/cloudflare/howtos/image
		"binding": "IMAGES"
	},
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "property-ly-db",
			"database_id": "509aa13e-5b65-43f5-80c0-73acb73ad561"
		}
	],
	"routes": [
		{ "pattern": "property.ly", "custom_domain": true },
		{ "pattern": "www.property.ly", "custom_domain": true },
		{ "pattern": "explore.ly", "custom_domain": true },
		{ "pattern": "www.explore.ly", "custom_domain": true },
		{ "pattern": "hotel.com.ly", "custom_domain": true },
		{ "pattern": "www.hotel.com.ly", "custom_domain": true },
		{ "pattern": "market.com.ly", "custom_domain": true },
		{ "pattern": "www.market.com.ly", "custom_domain": true },
		{ "pattern": "order.com.ly", "custom_domain": true },
		{ "pattern": "www.order.com.ly", "custom_domain": true }
	]
}